# =============================================================================
# SenAlert Backend — Configuration d'environnement
# =============================================================================
# Copiez ce fichier en .env et renseignez vos valeurs locales.
# NE JAMAIS committer le fichier .env réel dans Git.
# =============================================================================

# --- Django Core ---
# Générer une vraie clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=votre-cle-secrete-django-a-generer

# Mode debug (toujours False en production)
DEBUG=True

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=127.0.0.1,localhost,localhost:8000,10.0.2.2

# --- Base de données ---
# Option 1 (développement) : SQLite3 — configuration par défaut, aucune variable requise
# Option 2 (production) : Décommenter les lignes ci-dessous pour PostgreSQL
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=senalert_db
# DATABASE_USER=senalert_user
# DATABASE_PASSWORD=votre_mot_de_passe_postgresql
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# --- CORS ---
# En développement (DEBUG=True), CORS_ALLOW_ALL_ORIGINS sera True par défaut
CORS_ALLOW_ALL_ORIGINS=True
# En production (DEBUG=False), spécifier les origines autorisées
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Firebase Admin SDK ---
# Télécharger les credentials depuis Firebase Console
# Project > Settings > Service accounts > Generate new private key
FIREBASE_CREDENTIALS_PATH=firebase-adminsdk.json

# --- Groq AI (Assistant virtuel optionnel) ---
# Obtenir une clé sur https://console.groq.com
GROQ_API_KEY=gsk_votre_cle_groq_ici
