# =============================================================================
# SenAlert backend — configuration d'environnement (exemple SANS secret)
# Copiez ce fichier en .env et renseignez vos valeurs. Ne committez jamais .env.
# =============================================================================

# --- Django ---
# Générer : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
# Adresse publique de l'application web (liens des e-mails de réinitialisation)
FRONTEND_URL=http://127.0.0.1:8000/app

# --- Base de données ---
# Par défaut : SQLite (développement). Pour PostgreSQL :
# DB_ENGINE=postgresql
# DB_NAME=senalert
# DB_USER=senalert
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Production uniquement (DEBUG=False) ---
# CORS_ALLOWED_ORIGINS=https://senalert.example.sn
# CSRF_TRUSTED_ORIGINS=https://senalert.example.sn
# SECURE_SSL_REDIRECT=True

# --- Sessions JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- E-mail (réinitialisation du mot de passe) ---
# Sans configuration : les e-mails s'affichent dans la console du serveur.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=SenAlert <no-reply@example.sn>

# --- Connexion Google (OpenID Connect) ---
# Identifiants client OAuth créés dans Google Cloud Console (ce ne sont pas des secrets,
# mais seuls ces identifiants sont acceptés comme audience des jetons).
GOOGLE_CLIENT_ID_WEB=
# Identifiants Android/iOS séparés par des virgules (optionnel)
GOOGLE_CLIENT_IDS_MOBILE=

# --- Firebase Cloud Messaging ---
# Chemin du compte de service (Firebase Console > Paramètres > Comptes de service)
FIREBASE_CREDENTIALS_PATH=firebase-adminsdk.json

# --- Assistant IA (Groq) — clé UNIQUEMENT côté serveur ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT=15

# --- Services de proximité (OpenStreetMap / Overpass) ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
